<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow -->
    <item android:top="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#88000000"
                android:endColor="#00000000" />
            <corners android:bottomLeftRadius="2dp" android:bottomRightRadius="2dp" />
        </shape>
    </item>
    <!-- Shelf Plank -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#6B4423"
                android:centerColor="#4A2F1F"
                android:endColor="#2C1B14" />
            <corners android:radius="2dp" />
            <stroke
                android:width="1dp"
                android:color="#8D5B32" />
        </shape>
    </item>
</layer-list>
